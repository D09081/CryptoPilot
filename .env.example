# Copy to .env and fill in locally. NEVER commit real values.
CP_MODE=OBSERVE                 # OBSERVE | BACKTEST | DEMO | PAPER | LIVE (LIVE is blocked unless CP_LIVE_ENABLED=true)
CP_LIVE_ENABLED=false
CP_OWNER_TELEGRAM_ID=           # numeric Telegram user id of the single owner
CP_DATABASE_URL=sqlite:///cryptopilot.db

# Used by later stages (not read by the current core):
TELEGRAM_BOT_TOKEN=
OKX_API_KEY=                    # trade-only permission, NEVER withdraw
OKX_API_SECRET=
OKX_API_PASSPHRASE=
OKX_DEMO=true                   # use OKX demo trading
